[Unit]
Description=Temporary exact-path relay for legacy SmartVM callbacks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vnc/vending-legacy-callback-current
Environment=PATH=/home/vnc/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/vnc/.nvm/versions/node/v22.22.2/bin/node scripts/serve-legacy-smartvm-callback-relay.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=1024
TasksMax=64

[Install]
WantedBy=default.target
