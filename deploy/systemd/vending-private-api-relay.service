[Unit]
Description=Vending private API relay on the WireGuard release network
After=network-online.target vending-api-candidate.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fivegogogo/vending/current
Environment=PATH=/home/fivegogogo/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=PRIVATE_API_RELAY_BIND_HOST=10.66.66.2
Environment=PRIVATE_API_RELAY_PORT=8100
Environment=PRIVATE_API_RELAY_ALLOWED_SOURCES=10.66.66.1,10.66.66.2
Environment=PRIVATE_API_RELAY_ALLOWED_HOSTS=vending.5gogogo.top
Environment=PRIVATE_API_RELAY_ALLOWED_PROTOCOLS=https
Environment=PRIVATE_API_RELAY_SHARED_TOKEN_FILE=/home/fivegogogo/.config/vending/private-api-relay.token
Environment=PRIVATE_API_RELAY_HEALTH_PROBE_SOURCE=10.66.66.2
Environment=PRIVATE_API_RELAY_UPSTREAM_HOST=127.0.0.1
Environment=PRIVATE_API_RELAY_UPSTREAM_PORT=8100
ExecStart=/home/fivegogogo/.nvm/versions/node/v22.22.2/bin/npm run start:private-api-relay
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
