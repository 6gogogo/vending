# 本地浏览器 / H5 / App 联调：
VITE_API_BASE_URL=http://127.0.0.1:4000/api
VITE_SHOW_VERIFICATION_PREVIEW=false
VITE_ALLOW_REMOTE_API_IN_LOCAL_DEV=false
VITE_ENABLE_PUBLIC_ADMIN_REGISTRATION=false

# 微信开发者工具里如果开启了“不校验合法域名...”，也可以临时改成局域网 IP，例如：
# VITE_API_BASE_URL=http://192.168.1.20:4000/api

# 微信小程序真机和正式环境不能直接使用 http 或 IP。
# 体验版、审核版和正式版统一由受版本控制的 .env.production 固定为：
# VITE_API_BASE_URL=https://5gogogo.top/api
# 该域名还必须在微信公众平台“服务器域名”的 request 合法域名中配置为：
# https://5gogogo.top
