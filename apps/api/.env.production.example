# 此模板仅供受控部署系统参考；不要复制到当前模拟 .env，也不要把真实密钥提交到 Git。
# 生产服务应从密钥管理器/服务管理器注入敏感值，并且只运行一个 API 工作者。
NODE_ENV=production
APP_ENV=production
VM_DATA_PLANE=live
VM_DATA_ROOT=
VM_DATA_PLANE_ID=
# 当前业务只保留预约取货：特殊群体预约后开柜、领取核对，不创建新的支付或补扣单。
VM_RESERVATION_ONLY_PICKUP=true
# 当前真实实例的部署级显示名称；与 VM_DATA_PLANE_ID、PUBLIC_BASE_URL 一起固化到真实库。
VM_PLATFORM_TENANT_NAME=
# 仅在受控的一次性 `npm run init:live-data -- --confirm-live-initialization` 中临时注入首个超级管理员；
# 必须经密钥管理器或安全终端提供，初始化完成后移除，绝不能提交或长期保留在本文件。
# VM_INITIAL_SUPER_ADMIN_USERNAME=
# VM_INITIAL_SUPER_ADMIN_PASSWORD=
# VM_INITIAL_SUPER_ADMIN_PHONE=
# VM_INITIAL_SUPER_ADMIN_NAME=

PORT=4000
# 生产 API 只监听本机，由同机 Nginx 反向代理；启用 TRUST_PROXY_HOPS 时不可改为公网监听。
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=
PUBLIC_BASE_URL=
CORS_ORIGINS=
WEB_CONCURRENCY=1
API_INSTANCE_COUNT=1
NODE_APP_INSTANCE=0
BUSINESS_TIMEZONE_OFFSET_HOURS=8
BUSINESS_DAY_START_HOUR=4

# 真实平面不要设置 API_DATA_FILE、SYSTEM_LOG_FILE、UPLOAD_DIR、API_BACKUP_DIR 或
# FINANCIAL_SINGLE_WRITER_LEASE_FILE；全部路径由 VM_DATA_ROOT 派生。

# 柜机平台：必须由供应商交付生产 HTTPS 地址和真实租户凭据。
SMARTVM_BASE_URL=
SMARTVM_TIMEOUT_MS=15000
SMARTVM_STATUS_STALE_AFTER_MS=300000
SMARTVM_OPEN_COMMAND_LEASE_MS=120000
SMARTVM_ALLOWED_NOTIFY_ORIGINS=
SMARTVM_CLIENT_ID=
SMARTVM_KEY=
SMARTVM_ALLOW_UNSIGNED_CALLBACKS=false
SMARTVM_AUTO_FORWARD_SETTLEMENT_PAYMENT_SUCCESS=false
SMARTVM_DOOR_STATUS_CALLBACK_PATH=/api/cabinet-events/callbacks/door-status
SMARTVM_SETTLEMENT_CALLBACK_PATH=/api/cabinet-events/callbacks/settlement
SMARTVM_ADJUSTMENT_CALLBACK_PATH=/api/cabinet-events/callbacks/adjustment
SMARTVM_ADJUSTMENT_QUOTA_TIME_MODE=auto
SMARTVM_REFUND_CALLBACK_PATH=/api/inventory-orders/callbacks/refund
SMARTVM_PAYMENT_SUCCESS_PATH=/api/pay/container/paymentSuccess
SMARTVM_CALLBACK_MAX_AGE_SECONDS=300
SMARTVM_CALLBACK_FUTURE_TOLERANCE_SECONDS=60
SMARTVM_CALLBACK_EVENT_MAX_AGE_SECONDS=604800

# 真实支付与账本单写者。
PAYMENT_MODE=real
PAYMENT_MOCK_ENABLED=false
PAYMENT_PROVIDER_TIMEOUT_MS=15000
FINANCIAL_SINGLE_WRITER_ENABLED=true
FINANCIAL_INSTANCE_ID=
FINANCIAL_SINGLE_WRITER_LEASE_MS=30000
FINANCIAL_SINGLE_WRITER_HEARTBEAT_MS=10000
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_MS=30000
PAYMENT_RECONCILIATION_INITIAL_DELAY_MS=30000
PAYMENT_RECONCILIATION_MAX_DELAY_MS=1800000
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PAYMENT_RECONCILIATION_ALERT_AFTER_ATTEMPTS=5
PAYMENT_RECONCILIATION_USER_REQUEST_COOLDOWN_MS=15000
PAYMENT_NOT_FOUND_CONFIRMATIONS=2
PAYMENT_NOT_FOUND_GRACE_SECONDS=300
PAYMENT_PAYER_IDENTITY_TTL_SECONDS=120
PAYMENT_PAYER_IDENTITY_HANDLE_CAPACITY=4096

# 微信支付。PEM 私钥/公钥必须由密钥管理器以安全格式注入。
WECHAT_PAY_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_LOGIN_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=

# 支付宝普通公钥模式。
ALIPAY_APP_ID=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 阿里云号码认证 PNVS。四种业务用途必须配置为不同的审核方案。
VERIFICATION_CODE_PROVIDER=aliyun_pnvs
VERIFICATION_CODE_PREVIEW_ENABLED=false
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_REGION_ID=cn-hangzhou
ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_SCHEME_NAME_APP_LOGIN=
ALIYUN_PNVS_SCHEME_NAME_REGISTER=
ALIYUN_PNVS_SCHEME_NAME_GENERAL=
ALIYUN_PNVS_SCHEME_NAME_PASSWORD_RESET=

# 生产账号与本地模拟开关。
ALLOW_DEFAULT_BACKOFFICE_LOGIN=false
PUBLIC_ADMIN_REGISTRATION_ENABLED=false
ENABLE_LOCAL_MOCK_DEVICE_API=false
ENABLE_TEST_DEVICE_BOOTSTRAP=false

# 可选地图与 AI；未启用时可留空。
AMAP_WEB_KEY=
AMAP_SECURITY_JS_CODE=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_BASE_URL_EXACT_HOST_ALLOWLIST=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000

# PostgreSQL 迁移预留。当前业务主数据仍是受控 JSON 账本，不会因填写此项自动切库。
DATABASE_URL=
