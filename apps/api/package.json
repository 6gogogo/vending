{
  "name": "@vm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:typecheck && node scripts/run-isolated-tests.mjs",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "data:init": "tsx src/scripts/init-data.ts",
    "data:init:empty": "tsx src/scripts/init-empty-data.ts",
    "data:init:live": "tsx src/scripts/initialize-live-data.ts",
    "data:backup": "tsx src/scripts/runtime-data-maintenance.ts backup",
    "data:verify": "tsx src/scripts/runtime-data-maintenance.ts verify",
    "data:restore": "tsx src/scripts/runtime-data-maintenance.ts restore",
    "data:repair": "tsx src/scripts/runtime-data-maintenance.ts repair",
    "data:repair:missing-default-warehouse": "tsx src/scripts/repair-missing-default-warehouse.ts",
    "data:migrate:goods-taxonomy": "tsx src/scripts/migrate-goods-taxonomy.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:migrate-json": "tsx src/scripts/migrate-json-to-postgres.ts",
    "smoke:inventory": "node scripts/run-isolated-smoke.mjs inventory",
    "smoke:defensive": "node scripts/run-isolated-smoke.mjs defensive",
    "start:once": "tsx src/main.ts",
    "start:built": "tsx dist/apps/api/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^7.8.0",
    "@vm/shared-client": "file:../../packages/shared-client",
    "@vm/shared-types": "file:../../packages/shared-types",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
