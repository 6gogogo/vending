# 服务基础配置
# 样例仅用于本地模拟；正式环境由部署进程管理器注入 NODE_ENV=production、APP_ENV=production。
NODE_ENV=development
APP_ENV=development
# VM_DATA_PLANE=simulation 使用下面的旧本地路径；VM_DATA_PLANE=live 或全真模拟时必须只设置 VM_DATA_ROOT，
# 并且不能同时设置 API_DATA_FILE、UPLOAD_DIR、SYSTEM_LOG_FILE、API_BACKUP_DIR 或金融租约路径。
VM_DATA_PLANE=simulation
VM_DATA_ROOT=
# live 平面必须由部署系统提供不可变的实例标识；标准模拟默认使用 simulation-default。
VM_DATA_PLANE_ID=
# 全真模拟（隔离联调）：仍使用 simulation 数据平面，但可逐项接入真实柜机、支付、短信、AI 和地图。
# 启用时必须设置独立的 VM_DATA_ROOT、VM_DATA_PLANE_ID，且不能复用任何日常模拟或 live 数据目录。
VM_SIMULATION_PROFILE=standard
VM_FULL_SIMULATION_ENABLED=false
VM_FULL_SIMULATION_SMARTVM_MODE=mock
VM_FULL_SIMULATION_PAYMENT_MODE=mock
# 验证码可设置为 mock、real 或 manual；manual 只接受后台为已启用账号签发的短期一次性验证码，不发送短信。
VM_FULL_SIMULATION_VERIFICATION_MODE=mock
VM_FULL_SIMULATION_AI_MODE=mock
VM_FULL_SIMULATION_MAP_MODE=mock
# 预约取货模式：开启后，特殊群体仅可预约后取货；新开柜不产生支付或补扣。
# 当前默认流程为预约取货；历史支付兼容场景仅应在隔离测试中显式设置为 false。
VM_RESERVATION_ONLY_PICKUP=true
PORT=4000
API_HOST=127.0.0.1
# 只有在 API 前方确有固定层数的可信反向代理时才填写，例如 1。
TRUST_PROXY_HOPS=
PUBLIC_BASE_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
API_DATA_FILE=runtime-data/store.json
UPLOAD_DIR=runtime-uploads
SYSTEM_LOG_FILE=runtime-data/system-audit.ndjson
API_BACKUP_DIR=runtime-backups
# 仅本地回环联调需要时临时开启；生产及非回环监听会强制拒绝模拟柜机接口。
ENABLE_LOCAL_MOCK_DEVICE_API=false
# 仅隔离测试数据需要时补入比赛测试柜机；默认不得污染日常或真实数据文件。
ENABLE_TEST_DEVICE_BOOTSTRAP=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vending_machine?schema=public
# JSON 账本真实阶段必须由部署系统显式设为 1；不得使用 cluster 多实例。
WEB_CONCURRENCY=
API_INSTANCE_COUNT=
NODE_APP_INSTANCE=
BUSINESS_TIMEZONE_OFFSET_HOURS=8
BUSINESS_DAY_START_HOUR=4

# 地图服务
AMAP_WEB_KEY=
AMAP_SECURITY_JS_CODE=

# OpenAI 兼容大模型：标准模拟必须留空 OPENAI_API_KEY；全真模拟由 VM_FULL_SIMULATION_AI_MODE 控制是否外发；真实平面如需启用，仅由受控生产配置注入。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认仅允许 HTTPS 公网目标；本地/私网模型必须逐个填写精确主机名或 IP，不支持通配符。
OPENAI_BASE_URL_EXACT_HOST_ALLOWLIST=
OPENAI_MODEL=qwen2.5-vl-72b-instruct
OPENAI_TIMEOUT_MS=30000

# 柜机平台接入：标准模拟只能留空，网关会使用内存 mock；全真模拟由 VM_FULL_SIMULATION_SMARTVM_MODE 控制。
# 真实平面无柜机时可设为 disabled；录入首台柜机前必须切换为 real 并配置生产地址与凭据。
SMARTVM_MODE=
SMARTVM_BASE_URL=
SMARTVM_TIMEOUT_MS=15000
SMARTVM_STATUS_STALE_AFTER_MS=300000
SMARTVM_OPEN_COMMAND_LEASE_MS=120000
SMARTVM_ALLOWED_NOTIFY_ORIGINS=
SMARTVM_CLIENT_ID=
SMARTVM_KEY=
SMARTVM_ALLOW_UNSIGNED_CALLBACKS=false
SMARTVM_DEFAULT_PAY_STYLE=2
SMARTVM_AUTO_FORWARD_SETTLEMENT_PAYMENT_SUCCESS=false
SMARTVM_TEST_DEVICE_CODE=91120149
SMARTVM_TEST_DOOR_NUM=1
SMARTVM_DOOR_STATUS_CALLBACK_PATH=/api/cabinet-events/callbacks/door-status
SMARTVM_SETTLEMENT_CALLBACK_PATH=/api/cabinet-events/callbacks/settlement
SMARTVM_ADJUSTMENT_CALLBACK_PATH=/api/cabinet-events/callbacks/adjustment
SMARTVM_ADJUSTMENT_QUOTA_TIME_MODE=auto
SMARTVM_REFUND_CALLBACK_PATH=/api/inventory-orders/callbacks/refund
SMARTVM_PAYMENT_SUCCESS_PATH=/api/pay/container/paymentSuccess
SMARTVM_CALLBACK_MAX_AGE_SECONDS=300
SMARTVM_CALLBACK_FUTURE_TOLERANCE_SECONDS=60
SMARTVM_CALLBACK_EVENT_MAX_AGE_SECONDS=604800

# 标准模拟固定使用 mock；全真模拟以 VM_FULL_SIMULATION_PAYMENT_MODE 为准；真实平面使用 real，
# 或在 VM_RESERVATION_ONLY_PICKUP=true 时显式使用 disabled。
PAYMENT_MODE=mock
PAYMENT_PROVIDER_TIMEOUT_MS=15000
PAYMENT_MOCK_ENABLED=true
# JSON 账本只支持一个金融写入者。本地也始终获取租约；此开关是生产显式声明门禁，生产必须为 true。
FINANCIAL_SINGLE_WRITER_ENABLED=false
FINANCIAL_INSTANCE_ID=
FINANCIAL_SINGLE_WRITER_LEASE_FILE=runtime-data/financial-single-writer.lock
FINANCIAL_SINGLE_WRITER_LEASE_MS=30000
FINANCIAL_SINGLE_WRITER_HEARTBEAT_MS=10000
# 真实支付/退款待确认状态的本地后台安全对账；模拟支付保持关闭。
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_INTERVAL_MS=30000
PAYMENT_RECONCILIATION_INITIAL_DELAY_MS=30000
PAYMENT_RECONCILIATION_MAX_DELAY_MS=1800000
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PAYMENT_RECONCILIATION_ALERT_AFTER_ATTEMPTS=5
PAYMENT_RECONCILIATION_USER_REQUEST_COOLDOWN_MS=15000
PAYMENT_NOT_FOUND_CONFIRMATIONS=2
PAYMENT_NOT_FOUND_GRACE_SECONDS=300
PAYMENT_PAYER_IDENTITY_TTL_SECONDS=120
PAYMENT_PAYER_IDENTITY_HANDLE_CAPACITY=4096
WECHAT_PAY_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_LOGIN_URL=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_BASE_URL=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
ALIPAY_APP_ID=
ALIPAY_GATEWAY_URL=
ALIPAY_NOTIFY_URL=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 验证码服务：标准模拟固定 mock；全真模拟以 VM_FULL_SIMULATION_VERIFICATION_MODE 为准；
# 真实平面可用 aliyun_pnvs，或仅接受后台签发一次性验证码的 manual。
VERIFICATION_CODE_PROVIDER=mock
VERIFICATION_CODE_PREVIEW_ENABLED=false
ALLOW_DEFAULT_BACKOFFICE_LOGIN=false
PUBLIC_ADMIN_REGISTRATION_ENABLED=false
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_REGION_ID=cn-hangzhou
ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_SCHEME_NAME_APP_LOGIN=
ALIYUN_PNVS_SCHEME_NAME_REGISTER=
ALIYUN_PNVS_SCHEME_NAME_GENERAL=
ALIYUN_PNVS_SCHEME_NAME_PASSWORD_RESET=
