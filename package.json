{
  "name": "vending-machine-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "init:api-data": "npm run data:init --workspace @vm/api",
    "init:all-data": "npm run data:init:empty --workspace @vm/api --",
    "init:live-data": "npm run data:init:live --workspace @vm/api",
    "init:first-backoffice-password": "npm run data:init:first-backoffice-password --workspace @vm/api",
    "init:all-data:keep-uploads": "npm run data:init:empty --workspace @vm/api -- --keep-uploads",
    "backup:api-data": "npm run data:backup --workspace @vm/api --",
    "verify:api-data": "npm run data:verify --workspace @vm/api --",
    "repair:api-data": "npm run data:repair --workspace @vm/api --",
    "restore:api-data": "npm run data:restore --workspace @vm/api --",
    "db:api:generate": "npm run db:generate --workspace @vm/api",
    "db:api:push": "npm run db:push --workspace @vm/api",
    "db:api:migrate": "npm run db:migrate --workspace @vm/api",
    "db:api:migrate-json": "npm run db:migrate-json --workspace @vm/api",
    "dev:api": "npm run start:dev --workspace @vm/api",
    "dev:api:once": "npm run start:once --workspace @vm/api",
    "start:api:built": "npm run start:built --workspace @vm/api",
    "dev:admin": "npm run dev --workspace @vm/admin-web",
    "dev:mobile": "npm run dev --workspace @vm/mobile",
    "dev:mobile:weixin": "npm run dev:weixin --workspace @vm/mobile",
    "dev:mobile:alipay": "npm run dev:alipay --workspace @vm/mobile",
    "dev:mobile:app": "npm run dev:app --workspace @vm/mobile",
    "build:mobile:app": "npm run build:app --workspace @vm/mobile",
    "build:mobile:weixin": "npm run build:weixin --workspace @vm/mobile",
    "build:mobile:alipay": "npm run build:alipay --workspace @vm/mobile",
    "build:public-web": "npm run build --workspace @vm/admin-web && npm run build:h5:deployment --workspace @vm/mobile",
    "sandbox:device": "node sandbox/scripts/query-device-info.mjs",
    "sandbox:ai": "node sandbox/scripts/check-ai.mjs",
    "sandbox:events": "node sandbox/scripts/query-events.mjs",
    "sandbox:door": "node sandbox/scripts/open-door.mjs sandbox/fixtures/open-door.sample.json",
    "sandbox:door:probe": "node sandbox/scripts/probe-open-door.mjs",
    "sandbox:door-status": "node sandbox/scripts/simulate-door-status.mjs sandbox/fixtures/door-status.sample.json",
    "sandbox:goods": "node sandbox/scripts/query-goods.mjs",
    "sandbox:latest-event": "node sandbox/scripts/simulate-latest-event.mjs",
    "sandbox:mock-device": "node sandbox/scripts/upsert-mock-device.mjs sandbox/fixtures/mock-device.sample.json",
    "sandbox:payment-success": "node sandbox/scripts/payment-success.mjs",
    "sandbox:payment-success:api": "node sandbox/scripts/payment-success-via-api.mjs",
    "sandbox:external-preflight": "node sandbox/scripts/external-preflight.mjs",
    "sandbox:refund": "node sandbox/scripts/refund.mjs sandbox/fixtures/refund.sample.json",
    "sandbox:refund:api": "node sandbox/scripts/refund-via-api.mjs",
    "sandbox:sms:send": "node sandbox/scripts/send-sms-code.mjs",
    "sandbox:sms:verify": "node sandbox/scripts/verify-sms-code.mjs",
    "sandbox:settlement": "node sandbox/scripts/simulate-settlement.mjs",
    "sandbox:sign": "node sandbox/scripts/generate-signature.mjs sandbox/fixtures/open-door.sample.json",
    "start:public-web": "node scripts/serve-public-web.mjs",
    "test:public-web": "node --test scripts/serve-public-web.test.mjs",
    "start:private-api-relay": "node scripts/serve-private-api-relay.mjs",
    "test:private-api-relay": "node --test scripts/serve-private-api-relay.test.mjs",
    "start:public-edge-relay": "node scripts/serve-public-edge-relay.mjs",
    "test:public-edge-relay": "node --test scripts/serve-public-edge-relay.test.mjs",
    "start:public-http-entry-redirect": "node scripts/serve-public-http-entry-redirect.mjs",
    "test:public-http-entry-redirect": "node --test scripts/serve-public-http-entry-redirect.test.mjs",
    "test:vnc-nginx-edge-contract": "node --test scripts/verify-vnc-nginx-edge-contract.test.mjs",
    "test:vending-public-ingress-root-action": "node --test scripts/vending-public-ingress-root-action.test.mjs",
    "smoke:frontend-safety": "node scripts/smoke-frontend-safety.mjs",
    "check:local": "npm run typecheck && npm test --workspace @vm/api && npm test --workspace @vm/mobile && npm test --workspace @vm/admin-web && npm run smoke:inventory --workspace @vm/api && npm run smoke:defensive --workspace @vm/api && npm run smoke:frontend-safety && npm run test:public-web && npm run test:private-api-relay && npm run test:public-edge-relay && npm run test:public-http-entry-redirect && npm run test:vnc-nginx-edge-contract && npm run test:vending-public-ingress-root-action",
    "check:local:full": "npm run check:local && npm run build && npm run build:mobile:weixin && npm run build:mobile:alipay && npm run build:mobile:app",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
